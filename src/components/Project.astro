---
import GithubButton from "./GithubButton.astro"
import Placeholder from "./Placeholder.astro"

const { title, repository } = Astro.props
---

<div class="py-2.5 flex gap-3 items-stretch">
  <div class="flex flex-col justify-between">
    <div>
      <h3 class="text-lg font-bold">{title}</h3>
      <slot />
    </div>
    <GithubButton repository={repository} />
  </div>
  <Placeholder />
</div>