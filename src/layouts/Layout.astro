---
const { title } = Astro.props;

---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body class="bg-white bg-fixed bg-[url(/Tile.webp)] bg-size-[25px]">
    <slot />
  </body>
</html>